{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "*.rules", "cors.json", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|js|json|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" }
}
